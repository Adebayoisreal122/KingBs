PORT=5000
NODE_ENV=development

# MongoDB — replace with your Atlas URI in production
MONGO_URI=mongodb://localhost:27017/autoelite

# JWT — use a long random secret (min 32 chars) in production
JWT_SECRET=autoelite_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin seed credentials
ADMIN_NAME=AutoElite Admin
ADMIN_EMAIL=admin@autoelite.com
ADMIN_PASSWORD=Admin@2024!

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
